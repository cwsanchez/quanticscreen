# Supabase Configuration
# Get these from your Supabase Dashboard → Project Settings → API

# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Publishable key (Dashboard → Settings → API → Project API keys → "Publishable key")
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key-here

# Secret key (Dashboard → Settings → API → Project API keys → "Secret key")
# Server-side only — never expose to client
SUPABASE_SERVICE_ROLE_KEY=your-secret-key-here

# Optional: Cron secret for Vercel cron jobs (required in production)
CRON_SECRET=your-cron-secret-here

# xAI (Grok) API key — required to enable the "AI Analysis" tab and weekly
# AI-generated company analysis. Get one at https://x.ai/api
# Without this key the app still works; the AI Analysis tab will prompt the
# user that it is disabled.
XAI_API_KEY=your-xai-api-key-here
